-- =============================================================================
-- data.mif
-- Data Memory initialization
--
-- Word address = byte_address / 4
--
-- Initial values used by the counter program:
--   word 000 (byte  0) : 0x00000400 = MMIO base address
--   word 001 (byte  4) : 0x00000008 = KEY3 mask
--   word 002 (byte  8) : 0x00000004 = KEY2 mask
--   word 003 (byte 12) : 0x00000002 = KEY1 mask
--   word 004 (byte 16) : 0x00000001 = increment/decrement value
--
-- Remaining memory positions are initialized to zero.
-- =============================================================================

DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
BEGIN

00 : 00000400;
01 : 00000008;
02 : 00000004;
03 : 00000002;
04 : 00000001;
[05..FF] : 00000000;

END;