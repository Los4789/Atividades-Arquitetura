00C : 00717233;  -- and x4,x2,x7
00D : 02020863;  -- beq x4,x0,48
00E : 000104B3;  -- add x9,x2,x0
00F : 0030A623;  -- sw x3,12(x1)
010 : FC000EE3;  -- beq x0,x0,-36
011 : 0054F233;  -- and x4,x9,x5
012 : FE0200E3;  -- beq x4,x0,-32
013 : 008181B3;  -- add x3,x3,x8
014 : FC000CE3;  -- beq x0,x0,-40
015 : 0064F233;  -- and x4,x9,x6
016 : FC020CE3;  -- beq x4,x0,-40
017 : 408181B3;  -- sub x3,x3,x8
018 : FC0008E3;  -- beq x0,x0,-48
