DEPTH = 256;            -- The size of memory in words
WIDTH = 32;             -- The size of data in bits
ADDRESS_RADIX = HEX;    -- The radix for address values
DATA_RADIX = HEX;       -- The radix for data values
CONTENT                 -- Start of (address: data pairs)
BEGIN

000 : 00002083;  -- lw x1,0(x0)
001 : 00402283;  -- lw x5,4(x0)
002 : 00802303;  -- lw x6,8(x0)
003 : 00C02383;  -- lw x7,12(x0)
004 : 01002403;  -- lw x8,16(x0)
005 : 0040A483;  -- lw x9,4(x1)
006 : 400001B3;  -- sub x3,x0,x0
007 : 0040A103;  -- lw x2,4(x1)
008 : 00517233;  -- and x4,x2,x5
009 : 02020063;  -- beq x4,x0,32
00A : 00617233;  -- and x4,x2,x6
